import numpy as np
from sklearn.preprocessing import StandardScaler

data = np.array([
    [20, 20000],
    [25, 30000],
    [30, 40000],
    [35, 50000],
    [40, 60000]
])

scaler = StandardScaler()
result = scaler.fit_transform(data)

print("StandardScaler Output:")
print(result)

print("Minimum:", result.min())
print("Maximum:", result.max())
